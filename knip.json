{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["App.tsx", "__tests__/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts"],
  "ignoreBinaries": ["swiftlint", "maestro", "xcpretty"],
  "ignoreDependencies": [
